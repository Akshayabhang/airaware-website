# =============================================================================
# AirWave — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# The .env file itself is gitignored and must NEVER be committed.
# On Hostinger: enter these in hPanel → Websites → Your Site → Environment Variables
# =============================================================================

# --- Turso Cloud Database (replaces local SQLite) ---
# Your Turso database dashboard: https://app.turso.tech/akshayabhang/databases/airaware-db
TURSO_DATABASE_URL="libsql://airaware-db-akshayabhang.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# --- WAQI (World Air Quality Index) API ---
# Get your free token at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN="your-waqi-api-token-here"

# --- Windy API (Map layer) ---
# Get your key at: https://api.windy.com/
NEXT_PUBLIC_WINDY_API_KEY="your-windy-api-key-here"

# --- Indian Weather API ---
# Get your key at: https://indianapi.in/
INDIAN_WEATHER_API_KEY="your-indian-weather-api-key-here"

# --- OpenWeatherMap API (Geocoding + Weather) ---
# Get your free key at: https://openweathermap.org/api
NEXT_PUBLIC_OWM_API_KEY="your-openweathermap-api-key-here"
